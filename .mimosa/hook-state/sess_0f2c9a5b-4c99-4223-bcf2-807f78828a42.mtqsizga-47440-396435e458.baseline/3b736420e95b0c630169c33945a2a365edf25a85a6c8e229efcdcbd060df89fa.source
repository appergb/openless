import { AbsoluteFill, staticFile, Img, useCurrentFrame, useVideoConfig } from "remotion";
import { Backdrop } from "../components/Backdrop";
import { LightBand } from "../components/SvgMotion";
import { COLORS, FONT } from "../design/tokens";
import { springIn } from "../design/motion";

export const LogoRewriteScene = () => {
  const frame = useCurrentFrame();
  const { fps } = useVideoConfig();
  const imageIn = springIn(frame, fps, 4);

  return (
    <AbsoluteFill>
      <Backdrop intensity={0.36} drift={0.35} />
      <LightBand delay={212} opacity={0.5} />
      <div
        style={{
          position: "absolute",
          top: 184,
          left: 250,
          width: 430,
          height: 430,
          transform: `translateY(${(1 - imageIn) * 34}px) scale(${0.96 + imageIn * 0.04})`,
          opacity: imageIn,
          filter: "drop-shadow(0 34px 90px rgba(11,42,102,0.14))",
        }}
      >
        <Img
          src={staticFile("assets/app-icon.png")}
          style={{ width: "100%", height: "100%", objectFit: "contain" }}
        />
      </div>
      <div
        style={{
          position: "absolute",
          top: 292,
          right: 198,
          width: 720,
          textAlign: "left",
          fontFamily: `${FONT.zh}, ${FONT.sans}`,
        }}
      >
        <div style={{ fontSize: 72, lineHeight: 1.06, fontWeight: 860, color: COLORS.ink }}>
          语言先行。
          <br />
          文字自然跟上。
        </div>
        <div style={{ marginTop: 28, fontSize: 30, lineHeight: 1.55, color: COLORS.muted, fontWeight: 520 }}>
          不用先把脑子里的想法打磨成句子。
          <br />
          直接说出来，OpenLess 在光标处落下完整提示词。
        </div>
      </div>
    </AbsoluteFill>
  );
};
