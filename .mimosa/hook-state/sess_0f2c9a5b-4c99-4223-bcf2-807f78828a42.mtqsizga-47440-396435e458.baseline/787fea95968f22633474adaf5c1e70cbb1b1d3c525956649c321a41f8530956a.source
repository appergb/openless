import { AbsoluteFill, Img, staticFile, useCurrentFrame, useVideoConfig } from "remotion";
import { Backdrop } from "../components/Backdrop";
import { KeyCaps, LightBand, MenuBarPill, Waveform } from "../components/SvgMotion";
import { COLORS, FONT } from "../design/tokens";
import { softIn, springIn } from "../design/motion";

export const OpeningScene = () => {
  const frame = useCurrentFrame();
  const { fps } = useVideoConfig();
  const logoIn = springIn(frame, fps, 18);
  const subIn = softIn(frame, 124, 176);

  return (
    <AbsoluteFill>
      <Backdrop intensity={0.42} drift={0.45} />
      <LightBand delay={54} opacity={0.72} />
      <div style={{ position: "absolute", top: 96, left: 96 }}>
        <MenuBarPill delay={18} />
      </div>
      <div style={{ position: "absolute", top: 108, right: 118 }}>
        <KeyCaps keys={["⌘", "Space"]} />
      </div>
      <div
        style={{
          position: "absolute",
          top: 166,
          left: "50%",
          width: 420,
          height: 420,
          transform: `translateX(-50%) translateY(${(1 - logoIn) * 26}px) scale(${0.94 + logoIn * 0.06})`,
          opacity: logoIn,
          filter: "drop-shadow(0 34px 90px rgba(11,42,102,0.16))",
        }}
      >
        <Img
          src={staticFile("assets/app-icon.png")}
          style={{ width: "100%", height: "100%", objectFit: "contain" }}
        />
      </div>
      <div
        style={{
          position: "absolute",
          top: 632,
          left: 0,
          right: 0,
          display: "flex",
          justifyContent: "center",
          transform: `translateY(${(1 - subIn) * 30}px)`,
          opacity: subIn,
        }}
      >
        <div
          style={{
            fontFamily: `${FONT.zh}, ${FONT.sans}`,
            fontSize: 34,
            lineHeight: 1.5,
            color: COLORS.muted,
            textAlign: "center",
            fontWeight: 520,
          }}
        >
          Just Speak.
          <br />
          把脑子里散乱的想法说出来，OpenLess 自动整理成结构化提示词
        </div>
      </div>
      <div style={{ position: "absolute", left: "50%", bottom: 96, transform: "translateX(-50%)" }}>
        <Waveform />
      </div>
    </AbsoluteFill>
  );
};
