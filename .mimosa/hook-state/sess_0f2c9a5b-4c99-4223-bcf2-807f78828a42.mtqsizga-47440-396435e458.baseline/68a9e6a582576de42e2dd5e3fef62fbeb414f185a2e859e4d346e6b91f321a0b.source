import { AbsoluteFill, interpolate, useCurrentFrame } from "remotion";
import { Backdrop } from "../components/Backdrop";
import { LightBand } from "../components/SvgMotion";
import { COLORS, FONT, SHADOW } from "../design/tokens";
import { progress, softIn } from "../design/motion";

const steps = [
  { title: "AX 直写", body: "优先直接写入当前焦点" },
  { title: "Cmd+V", body: "必要时自动粘贴" },
  { title: "Copy fallback", body: "最后仍保留在剪贴板" },
];

export const ContractScene = () => {
  const frame = useCurrentFrame();
  const titleIn = softIn(frame, 0, 40);

  return (
    <AbsoluteFill>
      <Backdrop intensity={0.58} drift={0.35} />
      <LightBand delay={188} opacity={0.46} />
      <div
        style={{
          position: "absolute",
          top: 145,
          left: 0,
          right: 0,
          textAlign: "center",
          fontFamily: `${FONT.zh}, ${FONT.sans}`,
          opacity: titleIn,
          transform: `translateY(${(1 - titleIn) * 18}px)`,
        }}
      >
        <div style={{ fontSize: 78, fontWeight: 880, color: COLORS.ink }}>原话不丢失。</div>
        <div style={{ marginTop: 18, fontSize: 28, color: COLORS.muted }}>底层契约很简单：能写入就写入，写不进也不会丢。</div>
      </div>
      <div style={{ position: "absolute", left: 230, right: 230, top: 460, display: "flex", alignItems: "center", justifyContent: "space-between" }}>
        {steps.map((step, index) => {
          const p = progress(frame, 74 + index * 34, 134 + index * 34);
          return (
            <div key={step.title} style={{ display: "flex", alignItems: "center" }}>
              <div
                style={{
                  width: 370,
                  height: 188,
                  borderRadius: 32,
                  background: p > 0.5 ? "linear-gradient(135deg, rgba(255,255,255,0.98), rgba(239,246,255,0.9))" : "rgba(255,255,255,0.74)",
                  border: `1px solid ${p > 0.5 ? "rgba(37,99,235,0.24)" : COLORS.hairline}`,
                  boxShadow: p > 0.5 ? SHADOW.lift : "0 12px 42px rgba(18,24,40,0.08)",
                  transform: `translateY(${(1 - p) * 36}px)`,
                  opacity: p,
                  display: "grid",
                  placeItems: "center",
                  textAlign: "center",
                  fontFamily: `${FONT.zh}, ${FONT.sans}`,
                }}
              >
                <div>
                  <div style={{ fontSize: 40, fontWeight: 860, color: COLORS.ink }}>{step.title}</div>
                  <div style={{ marginTop: 12, fontSize: 22, color: COLORS.muted }}>{step.body}</div>
                </div>
              </div>
              {index < steps.length - 1 ? (
                <svg width="130" height="40" viewBox="0 0 130 40" style={{ margin: "0 28px" }}>
                  <path
                    d="M8 20 H112"
                    stroke={COLORS.blue2}
                    strokeWidth="3"
                    strokeLinecap="round"
                    strokeDasharray="120"
                    strokeDashoffset={120 - 120 * progress(frame, 130 + index * 48, 190 + index * 48)}
                    opacity="0.42"
                  />
                  <path d="M106 10 L122 20 L106 30" fill="none" stroke={COLORS.blue2} strokeWidth="3" strokeLinecap="round" strokeLinejoin="round" opacity="0.42" />
                </svg>
              ) : null}
            </div>
          );
        })}
      </div>
      <div
        style={{
          position: "absolute",
          left: 0,
          right: 0,
          bottom: 128,
          textAlign: "center",
          fontFamily: FONT.sans,
          fontSize: 24,
          color: COLORS.muted,
          opacity: interpolate(frame, [230, 285], [0, 1], { extrapolateLeft: "clamp", extrapolateRight: "clamp" }),
        }}
      >
        ChatGPT · Claude · Gemini · Perplexity · any AI surface
      </div>
    </AbsoluteFill>
  );
};
