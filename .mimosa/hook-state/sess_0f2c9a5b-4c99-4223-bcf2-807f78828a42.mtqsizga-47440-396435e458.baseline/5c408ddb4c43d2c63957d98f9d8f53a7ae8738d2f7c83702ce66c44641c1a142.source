import { AbsoluteFill, interpolate, useCurrentFrame } from "remotion";
import { Backdrop } from "../components/Backdrop";
import { DemoVideo, MediaSurface } from "../components/MediaSurface";
import { KeyCaps, LightBand, MenuBarPill, Waveform } from "../components/SvgMotion";
import { COLORS, FONT } from "../design/tokens";
import { progress, softIn } from "../design/motion";

export const DemoLiveScene = () => {
  const frame = useCurrentFrame();
  const mediaScale = interpolate(frame, [0, 1260], [1.04, 1], { extrapolateRight: "clamp" });
  const line = progress(frame, 210, 360);
  const caption = softIn(frame, 64, 116);

  return (
    <AbsoluteFill>
      <Backdrop intensity={0.9} drift={0.44} />
      <LightBand delay={510} opacity={0.42} />
      <div style={{ position: "absolute", top: 76, left: 86, zIndex: 4 }}>
        <MenuBarPill delay={0} />
      </div>
      <div style={{ position: "absolute", top: 86, right: 96, zIndex: 4 }}>
        <KeyCaps keys={["⌥", "Space"]} />
      </div>
      <div style={{ position: "absolute", left: 108, top: 196, zIndex: 3, width: 430, opacity: caption }}>
        <div style={{ fontFamily: `${FONT.zh}, ${FONT.sans}`, color: COLORS.ink, fontSize: 64, fontWeight: 860, lineHeight: 1.08 }}>
          效果段实录
          <br />
          说完即写完
        </div>
        <div style={{ marginTop: 24, fontFamily: `${FONT.zh}, ${FONT.sans}`, color: COLORS.muted, fontSize: 28, lineHeight: 1.5 }}>
          从说完后的整理开始看。
          <br />
          口语变成完整提示词。
        </div>
      </div>
      <div style={{ position: "absolute", right: 82, bottom: 82, transform: `scale(${mediaScale})`, transformOrigin: "center" }}>
        <MediaSurface width={1310} height={737} delay={22} radius={38} chrome={false}>
          <DemoVideo src="assets/demo-live.mov" startFrom={1970} endAt={3230} playbackRate={1} />
          <svg width="1310" height="737" viewBox="0 0 1310 737" style={{ position: "absolute", inset: 0, zIndex: 5, pointerEvents: "none" }}>
            <defs>
              <linearGradient id="demo-arrow" x1="0%" x2="100%">
                <stop offset="0%" stopColor={COLORS.blue2} />
                <stop offset="100%" stopColor={COLORS.accentBlue} />
              </linearGradient>
            </defs>
            <path
              d="M995 625 C 940 568, 875 530, 796 498"
              fill="none"
              stroke="url(#demo-arrow)"
              strokeWidth="4"
              strokeLinecap="round"
              strokeDasharray="420"
              strokeDashoffset={420 - 420 * line}
              opacity={0.9}
            />
            <circle cx="1004" cy="632" r="18" fill="none" stroke={COLORS.accentBlue} strokeWidth="4" opacity={line} />
            <rect
              x="512"
              y="660"
              width="286"
              height="50"
              rx="25"
              fill="none"
              stroke={COLORS.accentBlue}
              strokeWidth="3"
              opacity={line * 0.82}
            />
          </svg>
        </MediaSurface>
      </div>
      <div
        style={{
          position: "absolute",
          left: 108,
          bottom: 116,
          width: 520,
          padding: "28px 30px",
          borderRadius: 30,
          background: "rgba(255,255,255,0.82)",
          border: `1px solid ${COLORS.hairline}`,
          boxShadow: "0 24px 80px rgba(11,42,102,0.14)",
          fontFamily: `${FONT.zh}, ${FONT.sans}`,
        }}
      >
        <div style={{ display: "flex", alignItems: "center", gap: 20 }}>
          <Waveform compact />
          <div>
            <div style={{ fontSize: 28, fontWeight: 840, color: COLORS.ink }}>一句口语</div>
            <div style={{ marginTop: 4, fontSize: 21, color: COLORS.muted }}>变成 AI 能直接执行的完整提示词</div>
          </div>
        </div>
      </div>
    </AbsoluteFill>
  );
};
