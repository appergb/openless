import { Img, OffthreadVideo, staticFile, useCurrentFrame, useVideoConfig } from "remotion";
import { COLORS, SHADOW } from "../design/tokens";
import { springIn } from "../design/motion";

type MediaSurfaceProps = {
  children: React.ReactNode;
  width: number;
  height: number;
  delay?: number;
  radius?: number;
  chrome?: boolean;
};

export const MediaSurface = ({ children, width, height, delay = 0, radius = 34, chrome = true }: MediaSurfaceProps) => {
  const frame = useCurrentFrame();
  const { fps } = useVideoConfig();
  const s = springIn(frame, fps, delay);

  return (
    <div
      style={{
        width,
        height,
        borderRadius: radius,
        overflow: "hidden",
        position: "relative",
        background: COLORS.white,
        border: `1px solid ${COLORS.hairline}`,
        boxShadow: SHADOW.media,
        transform: `translateY(${(1 - s) * 48}px) scale(${0.985 + s * 0.015})`,
        opacity: s,
      }}
    >
      {chrome ? (
        <div
          style={{
            position: "absolute",
            zIndex: 4,
            top: 0,
            left: 0,
            right: 0,
            height: 46,
            background: "linear-gradient(180deg, rgba(255,255,255,0.88) 0%, rgba(255,255,255,0.48) 100%)",
            borderBottom: "1px solid rgba(10,10,10,0.08)",
            display: "flex",
            alignItems: "center",
            paddingLeft: 22,
            gap: 9,
          }}
        >
          {["#FF5F57", "#FFBD2E", "#28C840"].map((color) => (
            <span key={color} style={{ width: 12, height: 12, borderRadius: 999, background: color, opacity: 0.78 }} />
          ))}
        </div>
      ) : null}
      {children}
    </div>
  );
};

export const DemoVideo = ({
  src,
  startFrom,
  endAt,
  playbackRate = 1,
  fit = "cover",
  volume = 1,
}: {
  src: string;
  startFrom?: number;
  endAt?: number;
  playbackRate?: number;
  fit?: "cover" | "contain";
  volume?: number;
}) => (
  <OffthreadVideo
    src={staticFile(src)}
    startFrom={startFrom}
    endAt={endAt}
    audioStreamIndex={0}
    playbackRate={playbackRate}
    volume={volume}
    style={{
      width: "100%",
      height: "100%",
      objectFit: fit,
      display: "block",
      backgroundColor: COLORS.white,
    }}
  />
);

export const AssetImage = ({
  src,
  fit = "cover",
  opacity = 1,
}: {
  src: string;
  fit?: "cover" | "contain";
  opacity?: number;
}) => (
  <Img
    src={staticFile(src)}
    style={{
      width: "100%",
      height: "100%",
      objectFit: fit,
      display: "block",
      opacity,
    }}
  />
);

export const BottomTextMask = ({
  height = 148,
  children,
}: {
  height?: number;
  children?: React.ReactNode;
}) => (
  <div
    style={{
      position: "absolute",
      left: 0,
      right: 0,
      bottom: 0,
      height,
      zIndex: 5,
      display: "grid",
      placeItems: "center",
      background:
        "linear-gradient(180deg, rgba(250,250,252,0) 0%, rgba(250,250,252,0.95) 26%, rgba(250,250,252,1) 100%)",
      backdropFilter: "blur(10px)",
    }}
  >
    {children}
  </div>
);
