import { AbsoluteFill, interpolate, useCurrentFrame } from "remotion";
import { COLORS } from "../design/tokens";

type BackdropProps = {
  intensity?: number;
  drift?: number;
};

export const Backdrop = ({ intensity = 1, drift = 1 }: BackdropProps) => {
  const frame = useCurrentFrame();
  const x = interpolate(frame, [0, 600], [-70, 70], { extrapolateRight: "extend" }) * drift;
  const y = interpolate(frame, [0, 600], [28, -26], { extrapolateRight: "extend" }) * drift;

  return (
    <AbsoluteFill style={{ overflow: "hidden", background: COLORS.paper }}>
      <AbsoluteFill
        style={{
          background:
            "linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(250,250,252,1) 64%, rgba(255,255,255,0.98) 100%)",
        }}
      />
      <svg width="1920" height="1080" viewBox="0 0 1920 1080" style={{ position: "absolute", inset: 0 }}>
        <defs>
          <filter id="glow-blur">
            <feGaussianBlur stdDeviation="88" />
          </filter>
          <linearGradient id="nebula-a" x1="0%" x2="100%" y1="0%" y2="100%">
            <stop offset="0%" stopColor={COLORS.blue2} stopOpacity={0.0} />
            <stop offset="48%" stopColor={COLORS.blue2} stopOpacity={0.14 * intensity} />
            <stop offset="78%" stopColor={COLORS.accentBlue} stopOpacity={0.08 * intensity} />
            <stop offset="100%" stopColor="#FFFFFF" stopOpacity={0.08 * intensity} />
          </linearGradient>
          <linearGradient id="nebula-b" x1="100%" x2="0%" y1="10%" y2="100%">
            <stop offset="0%" stopColor={COLORS.accentBlue} stopOpacity={0.0} />
            <stop offset="52%" stopColor={COLORS.accentBlue} stopOpacity={0.08 * intensity} />
            <stop offset="100%" stopColor={COLORS.blue} stopOpacity={0.06 * intensity} />
          </linearGradient>
        </defs>
        <g filter="url(#glow-blur)" transform={`translate(${x} ${y})`}>
          <path d="M-160 260 C 330 90, 640 145, 1000 320 S 1620 540, 2090 265" stroke="url(#nebula-a)" strokeWidth="230" fill="none" />
          <path d="M-80 850 C 360 620, 650 740, 1030 675 S 1640 410, 2060 710" stroke="url(#nebula-b)" strokeWidth="170" fill="none" />
        </g>
        <path d="M0 1020 C 330 960, 640 1000, 930 970 C 1240 936, 1580 970, 1920 910" stroke="rgba(10,10,10,0.045)" strokeWidth="1.2" fill="none" />
      </svg>
      <AbsoluteFill
        style={{
          opacity: 0.2,
          backgroundImage:
            "linear-gradient(rgba(10,10,10,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.035) 1px, transparent 1px)",
          backgroundSize: "96px 96px",
          maskImage: "linear-gradient(180deg, transparent 0%, black 30%, black 70%, transparent 100%)",
        }}
      />
    </AbsoluteFill>
  );
};
